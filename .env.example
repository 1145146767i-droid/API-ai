# Unified web search for GPT / DeepSeek / Claude / Qwen
TAVILY_API_KEY=your_tavily_api_key
TAVILY_BASE_URL=https://api.tavily.com/search

PORT=3000

# Meta Model API
META_API_KEY=your_meta_model_api_key
